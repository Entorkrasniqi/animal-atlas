{
  "name": "animal-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data": "tsx scripts/pipeline/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "check:data": "tsx scripts/check-data.ts",
    "build": "npm run check && npm run check:data && vite build",
    "build:fresh": "npm run data -- --refresh && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "i18n-iso-countries": "7.14.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-geo": "3.1.0",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/geojson": "7946.0.14",
    "@types/node": "^22.20.5",
    "@types/topojson-client": "3.1.5",
    "pbf": "^4.0.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "4.19.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
